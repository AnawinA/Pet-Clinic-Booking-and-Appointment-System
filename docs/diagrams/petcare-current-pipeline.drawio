        <mxCell id="edgeTrigger" value="start pipeline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2f6ea5;fontSize=12;fontColor=#17365d;" edge="1" parent="1" source="trigger" target="jenkins">
