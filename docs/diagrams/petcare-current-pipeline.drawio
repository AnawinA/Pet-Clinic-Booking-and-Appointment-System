          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="stageBand" value="Jenkins stages (each stage must succeed before the next stage runs)" style="swimlane;html=1;rounded=1;startSize=34;horizontal=1;fillColor=#eef8fb;swimlaneFillColor=#e1f4f8;strokeColor=#55b8c5;strokeWidth=2;fontStyle=1;fontSize=15;fontColor=#175f68;" vertex="1" parent="1">
          <mxGeometry x="35" y="255" width="1760" height="405" as="geometry"/>
        </mxCell>
        <mxCell id="checkout" value="1. CHECKOUT&#xa;&#xa;• checkout scm&#xa;• derive 12-char commit tag&#xa;• validate Docker Hub namespace&#xa;• generate temporary CI env files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#328db0;strokeWidth=2;fontSize=14;fontColor=#17365d;align=left;spacingLeft=12;" vertex="1" parent="stageBand">
          <mxGeometry x="20" y="60" width="245" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="sync" value="2. CONNECT &amp; SYNC&#xa;&#xa;• SSH / verify tools&#xa;• preflight docker info&#xa;• tar source to devtools&#xa;• write runtime and test env files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#328db0;strokeWidth=2;fontSize=14;fontColor=#17365d;align=left;spacingLeft=12;" vertex="1" parent="stageBand">
          <mxGeometry x="310" y="60" width="245" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="buildTest" value="3. BUILD &amp; VERIFY&#xa;&#xa;• docker compose build&#xa;• start PostgreSQL + test DB&#xa;• Ruff + mypy + Alembic&#xa;• pytest&#xa;• Gitleaks scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#328db0;strokeWidth=2;fontSize=14;fontColor=#17365d;align=left;spacingLeft=12;" vertex="1" parent="stageBand">
          <mxGeometry x="600" y="60" width="245" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="publish" value="4. PUBLISH&#xa;&#xa;• Docker Hub login&#xa;  via --password-stdin&#xa;• push backend + nginx&#xa;• commit and build-number tags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#328db0;strokeWidth=2;fontSize=14;fontColor=#17365d;align=left;spacingLeft=12;" vertex="1" parent="stageBand">
          <mxGeometry x="890" y="60" width="245" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="deploy" value="5. DEPLOY&#xa;&#xa;• pull web1 + nginx images&#xa;• compose up -d&#xa;• --no-build&#xa;• remove orphan services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#328db0;strokeWidth=2;fontSize=14;fontColor=#17365d;align=left;spacingLeft=12;" vertex="1" parent="stageBand">
          <mxGeometry x="1180" y="60" width="245" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="verify" value="6. POST-DEPLOY CHECK&#xa;&#xa;• seed sample records&#xa;• health + load balancing&#xa;• login / availability&#xa;• Prometheus targets&#xa;• fail with recovery guidance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#328db0;strokeWidth=2;fontSize=14;fontColor=#17365d;align=left;spacingLeft=12;" vertex="1" parent="stageBand">
